{
  "name": "an-gi",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "php server/bin/export-snapshot.php && tsc -b && vite build && node scripts/precompress.mjs",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "lint": "eslint .",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\" \"scripts/**/*.mjs\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css}\" \"scripts/**/*.mjs\"",
    "test": "node scripts/run-vitest.mjs run",
    "assets:food-reel": "node scripts/extract-food-atlas.mjs",
    "assets:garden": "node scripts/generate-crop-sprites.mjs",
    "assets:farm-items": "node scripts/farm-items/cut.mjs && node scripts/farm-items/cut.mjs --publish",
    "rules:export": "node scripts/export-game-rules.mjs",
    "check:motion": "node scripts/check-no-svg-animation.mjs",
    "sky:pots": "node scripts/sky-garden/prepare-pots.mjs",
    "sky:qa": "node scripts/sky-garden/contact-sheet.mjs",
    "sky:sim": "node scripts/sky-garden/sim.mjs",
    "sky:sheet": "node scripts/sky-garden/prepare-sheet.mjs",
    "verify": "npm run format:check && npm run lint && npm run typecheck && npm run test && npm run check:motion && npm run build",
    "catalogue:export": "php server/bin/export-snapshot.php",
    "ai:enrich": "php server/bin/ai-enrich.php",
    "test:server": "php server/bin/selftest.php && php server/bin/selftest-spins.php && php server/bin/selftest-sky.php && php server/bin/selftest-sky-friends.php",
    "test:account": "php server/bin/selftest-account.php && php server/bin/selftest-friends.php",
    "test:audit": "node scripts/run-vitest.mjs run src/domain/security-audit.test.ts",
    "test:audit:server": "php server/bin/selftest-security.php",
    "test:audit:security": "php server/bin/selftest-security.php --security"
  },
  "dependencies": {
    "@fontsource-variable/fraunces": "^5.3.0",
    "@fontsource/be-vietnam-pro": "^5.3.0",
    "@phosphor-icons/react": "^2.1.10",
    "@react-three/fiber": "^9.8.1",
    "lucide-react": "^1.48.0",
    "motion": "^13.4.5",
    "playcanvas": "2.22.6",
    "qrcode-generator": "^1.5.2",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^26.6.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^10.11.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.12.0",
    "jsdom": "^30.1.1",
    "prettier": "^3.9.9",
    "sharp": "^0.35.5",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.0",
    "vite": "^8.3.1",
    "vitest": "^5.0.2"
  }
}
