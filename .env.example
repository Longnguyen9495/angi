# Local XAMPP: MariaDB. Production VPS: DB_DRIVER=sqlite (DB_PATH relative to the project root).
DB_DRIVER=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=angi
DB_USER=root
DB_PASS=
# DB_PATH=storage/database/angi.sqlite

AI_BASE_URL=https://rexllm.xyz/v1
AI_API_KEY=replace-me
AI_MODEL=gpt-5.6-sol

ADMIN_USER=admin
ADMIN_PASSWORD=replace-me

# Guest accounts (email + one-time code). APP_ENV=local returns the code in the API response for testing.
APP_ENV=production
APP_URL=https://angi.local
APP_KEY=replace-with-a-long-random-string
# MAIL_DRIVER: log (writes storage/logs/mail.log) | mail (PHP mail()) | smtp
MAIL_DRIVER=log
MAIL_FROM=no-reply@example.com
MAIL_FROM_NAME=Bếp Việt
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=tls
# SMTP_USER=
# SMTP_PASS=
