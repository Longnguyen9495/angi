# Local XAMPP: MariaDB. Production VPS: DB_DRIVER=sqlite (DB_PATH relative to the project root).
DB_DRIVER=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=angi
DB_USER=root
DB_PASS=
# DB_PATH=storage/database/angi.sqlite

AI_BASE_URL=https://rexllm.xyz/v1
AI_API_KEY=replace-me
AI_MODEL=gpt-5.6-sol
# Optional: exact provider host names the AI key may be sent to (comma separated).
# AI_HOSTS=rexllm.xyz

# Server-only YouTube Data API v3 pilot (com-tam / pho-bo). Never expose this key to the client.
YOUTUBE_API_KEY=

# Admin: empty password disables the admin. 12+ characters in production.
ADMIN_USER=admin
ADMIN_PASSWORD=replace-me
# Optional second factor: a base32 secret for an authenticator app (then a 6-digit code is asked at login).
# ADMIN_TOTP_SECRET=

# Guest accounts (email + one-time code). APP_ENV=local returns the code in the API response for testing.
# Anything but APP_ENV=local is production: the API refuses to serve until
# `php server/bin/check-config.php` reports no problem (https APP_URL, random APP_KEY, real mail).
APP_ENV=production
APP_URL=https://angi.local
# At least 32 random characters, e.g. `php -r "echo bin2hex(random_bytes(32));"`.
# Changing it signs nobody out, but makes codes sent in the last 10 minutes invalid.
APP_KEY=replace-with-a-long-random-string
# When TLS ends at a reverse proxy, its IP(s): only then is X-Forwarded-Proto/For believed.
# TRUSTED_PROXIES=127.0.0.1
# Optional: exact https hosts dish videos may come from (otherwise only /uploads/videos/).
# MEDIA_HOSTS=cdn.example.com

# Spins bought by bank transfer (VietQR). The bank is set in the admin (Lượt quay & thanh toán);
# these only fill it until then: BIN (6 digits, e.g. 970436 Vietcombank), account number, holder.
# PAY_BANK_BIN=
# PAY_BANK_NAME=
# PAY_ACCOUNT_NO=
# PAY_ACCOUNT_NAME=
# Optional: SePay webhook key — point SePay at POST /api/pay/sepay ("Authorization: Apikey <key>")
# and a transfer with the order code in its message credits the spins by itself.
# SEPAY_API_KEY=
# Optional: an address that gets an email when an account reaches a new fair-play level.
# ADMIN_ALERT_EMAIL=

# MAIL_DRIVER: log (writes storage/logs/mail.log — local only) | mail (PHP mail()) | smtp
MAIL_DRIVER=log
MAIL_FROM=no-reply@example.com
MAIL_FROM_NAME="Ăn gì?"
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=tls
# SMTP_USER=
# SMTP_PASS=
